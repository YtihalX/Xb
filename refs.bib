@misc{Zhang:2026iyr,
  title = {Born-{{Oppenheimer}} Chiral Effective Field Theory and Its Application to \${{X}}\_b\$},
  author = {Zhang, Yu and Guo, Feng-Kun and Hanhart, Christoph and Nefediev, Alexey and P{\"u}tz, Paul},
  year = 2026,
  month = oct,
  number = {arXiv:2610.19066},
  eprint = {2610.19066},
  primaryclass = {hep-ph},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2610.19066},
  urldate = {2026-11-02},
  abstract = {Following the discovery of the exotic state \$X(3872)\$ in the charmonium spectrum, the possible existence of an analogous state, \$X\_b\$, in the bottomonium sector has attracted considerable attention of the hadronic physics community. In this work, we lay the ground for the development of Born-Oppenheimer chiral effective field theory (BO\${$\chi\$$}EFT), that allows us to include both quark and hadron degrees of freedom as well as the full complexity of the meson-exchange potential in a systematic way. For illustration, the formalism to leading order (LO) is applied to the system of \${$\chi\_$}\textbraceleft b1\textbraceright\$ states and in particular the \$X\_b\$. The two parameters that are present at this order are constrained using experimental information on the bottomonium spectrum together with lattice input on static quark-antiquark potentials, including string breaking effects. The framework identifies the observed \$1\textasciicircum\textbraceleft ++\textbraceright\$ state at 10.513 GeV with a predominantly molecular \$X\_b\$, the bottom counterpart of the \$X(3872)\$, and predicts an additional predominantly compact bottomonium state at 10.544 GeV, about 60 MeV below the \$B\textbackslash bar\textbraceleft B\textbraceright\textasciicircum *\$ threshold.},
  archiveprefix = {arXiv},
  langid = {english},
  keywords = {High Energy Physics - Experiment,High Energy Physics - Lattice,High Energy Physics - Phenomenology},
  file = {/home/choros/Zotero/storage/H4RIBJQU/Zhang et al. - 2026 - Born-Oppenheimer chiral effective field theory and its application to $X_b$.pdf}
}

