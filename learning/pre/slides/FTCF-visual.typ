// The three pieces of the LO potential as diagrams; `kind` is "s", "t" or "c".
// Single line B, double line B*; no B B φ vertex, so φ exchange turns B B̄* into B* B̄.
#let piece-diagram(kind) = cetz.canvas(length: 1cm, {
  import cetz.draw: *
  let lbl(pos, anchor, body) = content(pos, text(size: 15pt, body), anchor: anchor, padding: 0.08)
  let dot(p) = circle(p, radius: 0.08, fill: black, stroke: none)
  let meson(a, b, starred) = if starred {
    let (dx, dy) = (b.at(0) - a.at(0), b.at(1) - a.at(1))
    let l = calc.sqrt(dx * dx + dy * dy)
    let (nx, ny) = (-dy / l * 0.055, dx / l * 0.055)
    line((a.at(0) + nx, a.at(1) + ny), (b.at(0) + nx, b.at(1) + ny), stroke: 0.8pt)
    line((a.at(0) - nx, a.at(1) - ny), (b.at(0) - nx, b.at(1) - ny), stroke: 0.8pt)
  } else { line(a, b, stroke: 0.8pt) }
  let out = if kind == "t" { ($B^*$, $macron(B)$) } else { ($B$, $macron(B)^*$) }
  if kind == "s" {
    meson((0, 2), (1.4, 1), false)
    meson((0, 0), (1.4, 1), true)
    meson((3.6, 1), (5, 2), false)
    meson((3.6, 1), (5, 0), true)
    line((1.4, 1), (3.6, 1), stroke: 2pt + red)
    dot((1.4, 1))
    dot((3.6, 1))
    lbl((2.5, 1.12), "south", text(fill: red)[$[macron(b)b]_1(n P)$])
  } else if kind == "t" {
    meson((0, 2), (2.5, 2), false)
    meson((2.5, 2), (5, 2), true)
    meson((0, 0), (2.5, 0), true)
    meson((2.5, 0), (5, 0), false)
    line((2.5, 2), (2.5, 0), stroke: (thickness: 0.8pt, dash: "dashed"))
    dot((2.5, 2))
    dot((2.5, 0))
    lbl((2.62, 1), "west", text(fill: red)[$pi, eta$])
  } else {
    meson((0, 2), (2.5, 1), false)
    meson((0, 0), (2.5, 1), true)
    meson((2.5, 1), (5, 2), false)
    meson((2.5, 1), (5, 0), true)
    rect((2.28, 0.78), (2.72, 1.22), fill: red, stroke: none)
  }
  lbl((0, 2), "east", $B$)
  lbl((0, 0), "east", $macron(B)^*$)
  lbl((5, 2), "west", out.at(0))
  lbl((5, 0), "west", out.at(1))
})

// Power counting of the s-channel tower: the bare levels relative to threshold.
#let tower-counting = cetz.canvas(length: 1cm, {
  import cetz.draw: *
  let y(e) = (e + 800) / 1350 * 5.0
  let lbl(pos, anchor, body, size: 16pt) = content(pos, text(size: size, body), anchor: anchor, padding: 0.08)
  rect((0, y(-110)), (4.6, y(110)), fill: red.lighten(88%), stroke: none)
  line((0, y(0)), (3.2, y(0)), stroke: 0.9pt + red)
  lbl((3.3, y(0)), "west", text(fill: red)[threshold], size: 14pt)
  for n in range(5) {
    let e = 1000 * cornell-e-bare.at(n)
    let kept = n < 4
    let s = if kept { 2pt + curve-colours.at(n) } else { (paint: gray, thickness: 1.4pt, dash: "dashed") }
    line((0.7, y(e)), (3.2, y(e)), stroke: s)
    lbl((0.6, y(e)), "east", [$#(n + 1) P$])
  }
  lbl((1.95, y(500) + 0.15), "south", text(fill: gray)[$dots.v$])
  // brackets
  let bracket(e0, e1, body) = {
    line((4.9, y(e0)), (5.1, y(e0)), (5.1, y(e1)), (4.9, y(e1)), stroke: 0.8pt)
    lbl((5.25, (y(e0) + y(e1)) / 2), "west", body)
  }
  bracket(-730, 240)[explicit ($N = 4$)]
  bracket(440, 560)[$-> C(N)$]
})

