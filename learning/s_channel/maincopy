It's a s-channel bottomonia exchange in S-wave at leading order \IDK{LO because of S-wave or S-wave because of LO?}

This is the hamiltonian of the system consists of both bottomonium and heavy mesons.
\begin{equation}
	\mathcal H=\begin{pmatrix}
		H-\Mth & 0      & \cdots & \hat g     \\
		0      & H-\Mth & \cdots & \hat g     \\
		\vdots & \vdots & \ddots & \vdots     \\
		\hat g & \hat g & \cdots & H_{\rm MM}
	\end{pmatrix}.
	\label{eq:H}
\end{equation}

which acts on the state vector

\begin{equation}
	\ket{\Psi}=\begin{pmatrix}\lambda_1\ket{\bbar_1(1P)}\\ \lambda_2\ket{\bbar_1(2P)}\\ \vdots\\ \phi(q)\ket{\BBst}\end{pmatrix},\qquad
	\sum_n|\lambda_n|^2+\int\frac{q^2dq}{(2\pi)^3}|\phi(q)|^2=1 .
	\label{eq:state}
\end{equation}

To obtain the equation of heavy mesons we utilizes the completeness relation
\begin{equation}
	P_{Q} = \sum_n \ket{n}\bra{n}, \quad P_{M} = \int_0^\infty \frac{q^2dq}{2\pi^2}\ket{q}\bra{q},\quad P_Q + P_M = \bold{1},\quad P_Q P_M = 0
\end{equation}
Schemecatically writing hamiltonian as $\mathcal{H} = H_{QQ} + H_{MM} + \hat{g} + \hat{g}^\dagger$ where $H_{QQ} = P_Q(H-M_\text{th})P_Q = \sum_n E_n \ket{n}\bra{n}$ and $\hat{g} = P_M H P_Q$

now insert $\bold{1} = P_Q + P_M$ into the schrodinger equation $\mathcal{H} \ket{\Psi} = E\ket{\Psi}$ and project

\textcolor{red}{add detailed intermediate steps}

one arrives
\begin{equation}
	(E-H_{QQ})\,P_Q\ket\Psi=\hat g^\dagger P_M\ket\Psi,\qquad
	(E-H_{MM})\,P_M\ket\Psi=\hat g\,P_Q\ket\Psi .
\end{equation}

then we get $P_Q\ket{\Psi} = (E-H_{QQ})^{-1}\hat{g}^\dagger P_M\ket{\Psi}$

so the schrodinger equation of heavy mesons and the potential appear
\begin{equation}
	\big[H_{MM}+\hat V(E)\big]P_M\ket\Psi=E\,P_M\ket\Psi,\qquad
	\hat V(E)=\hat g\,(E-H_{QQ})^{-1}\hat g^\dagger=\sum_n\frac{\hat g\ket n\bra n\hat g^\dagger}{E-E_n}.
	\label{eq:Vop}
\end{equation}

