// The 1++ baseline fit and its four bound states, chi_b1(1P, 2P, 3P) and X_b, on the physical
// sheet below the BB* threshold (SPEC.md, user story 8). Parameters at full precision from
// code/HadronDynamics.jl/data/bochiEFT/central.toml; g = (2/sqrt 3) sqrt 2 g_l with
// g_l = 35 MeV (CONVENTIONS.md, "Bare-continuum vertex"). Energies in GeV from m_B + m_B*.
.{
    .sector = .@"1++",
    .parameters = .{
        .m_b = 4.534047672900046,
        .sigma = 0.19840639309997352,
        .gamma = -0.434,
        .v0 = 0.3714694358359325,
        .contact = -16.26782020427067,
        .g = 0.05715476066494084,
        .g_b = 0.56,
        .f_pi = 0.0922,
        .n_bare = 4,
        .cutoff = 4.0,
        .m_B = 5.27952,
        .m_Bstar = 5.32475,
        .m_pi = 0.138039407,
        .m_eta = 0.548,
        // The fit's historical PV reduced mass.
        .mu_pv = 2.6509501131648436,
    },
    .quadrature = .{ .panel_nodes = 16, .panel_length = 0.25, .pole_margin = 0.05 },
    // Straddling the real axis: path [0, Lambda] without nodes.
    .domain = .{
        .{ .sheet = .{ 1, 1, 1 }, .re = .{ -0.75, -0.001 }, .im = .{ -0.01, 0.01 } },
    },
    .search = .{ .min_size = 1e-4 },
    .output = "out/baseline-1pp.jsonl",
}
